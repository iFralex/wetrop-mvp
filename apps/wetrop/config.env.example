# Copy to .runtime/config.env. Never copy personal Steward configuration.
# All generated data remains inside this Wetrop checkout.
WETROP_PORT=4417
# Preferred: npm run wetrop:login for dedicated ChatGPT subscription sign-in.
# Alternative: configure a dedicated OpenAI-compatible endpoint.
WETROP_MODEL_URL=
WETROP_MODEL=
WETROP_MODEL_KEY=
# A dedicated Telegram bot from BotFather. Pair a private user in Company.
WETROP_TELEGRAM_TOKEN=
# COMPANY_ROOT defaults to ./company and must stay inside this checkout.
